<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net472</TargetFramework>
		<AssemblyName>CookingSimMP</AssemblyName>
		<RootNamespace>CookingSimMP</RootNamespace>
		<LangVersion>latest</LangVersion>
		<GameDir>C:\Program Files (x86)\Steam\steamapps\common\CookingSimulator</GameDir>
		<!-- Copy LiteNetLib.dll into bin so CopyToGame can pick it up -->
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
		<PackageReference Include="LiteNetLib" Version="1.3.5" />
		<Reference Include="BepInEx">
			<HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="0Harmony">
			<HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine">
			<HintPath>$(GameDir)\CookingSim_Data\Managed\UnityEngine.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.CoreModule">
			<HintPath>$(GameDir)\CookingSim_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.PhysicsModule">
			<HintPath>$(GameDir)\CookingSim_Data\Managed\UnityEngine.PhysicsModule.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.InputLegacyModule">
			<HintPath>$(GameDir)\CookingSim_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Assembly-CSharp">
			<HintPath>$(GameDir)\CookingSim_Data\Managed\Assembly-CSharp.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<!-- Copy the mod and LiteNetLib into the game's plugins folder after each build.
	     Close the game first: a running game locks these DLLs. -->
	<Target Name="CopyToGame" AfterTargets="Build">
		<Copy SourceFiles="$(TargetDir)$(AssemblyName).dll;$(TargetDir)LiteNetLib.dll" DestinationFolder="$(GameDir)\BepInEx\plugins" />
	</Target>
</Project>
